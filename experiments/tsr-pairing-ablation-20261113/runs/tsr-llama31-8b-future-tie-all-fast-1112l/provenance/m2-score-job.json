{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "zaninzeng-tsr-tie-all-m2-score-1112l",
    "namespace": "sn5-system-intern",
    "labels": {
      "owner": "zaninzeng",
      "app": "tsr-scoring",
      "toolkits/creator": "zaninzeng"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 21600,
    "ttlSecondsAfterFinished": 604800,
    "template": {
      "metadata": {
        "labels": {
          "owner": "zaninzeng",
          "app": "tsr-scoring"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsUser": 1016,
          "runAsGroup": 1016
        },
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "group",
                      "operator": "In",
                      "values": [
                        "shennong-5",
                        "shennong-5-dev"
                      ]
                    }
                  ]
                }
              ]
            },
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "preference": {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "In",
                      "values": [
                        "hyperpod-i-039a10dbe287ac526"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "tolerations": [
          {
            "key": "nvidia.com/gpu",
            "operator": "Exists",
            "effect": "NoSchedule"
          },
          {
            "key": "role",
            "operator": "Exists",
            "effect": "NoSchedule"
          },
          {
            "key": "glm5sft",
            "operator": "Exists",
            "effect": "NoSchedule"
          }
        ],
        "containers": [
          {
            "name": "score",
            "image": "pytorch/pytorch@sha256:14611869895df612b7b07227d5925f30ec3cd6673bad58ce3d84ed107950e014",
            "command": [
              "/mnt/sn-007/zaninzeng/tsr-reproduction/.venv/bin/python",
              "-u",
              "/mnt/sn-007/zaninzeng/tsr-reproduction/work/runs/tsr-llama31-8b-future-tie-all-fast-1112l/bundle/scripts/score_when_ready.py",
              "--run",
              "/mnt/sn-007/zaninzeng/tsr-reproduction/work/runs/tsr-llama31-8b-future-tie-all-fast-1112l",
              "--credentials",
              "/mnt/sn-007/zaninzeng/tsr-reproduction/.runtime/secrets/judge.json",
              "--timeout-hours",
              "5",
              "--api-concurrency",
              "16",
              "--only",
              "M2_future_tie_unfiltered"
            ],
            "env": [
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "TZ",
                "value": "Asia/Shanghai"
              },
              {
                "name": "CUDA_VISIBLE_DEVICES",
                "value": ""
              },
              {
                "name": "HF_HOME",
                "value": "/mnt/sn-007/zaninzeng/tsr-reproduction/work/runs/tsr-llama31-8b-future-tie-all-fast-1112l/scoring/hf-cache"
              },
              {
                "name": "HF_HUB_OFFLINE",
                "value": "1"
              },
              {
                "name": "HF_DATASETS_CACHE",
                "value": "/mnt/sn-007/zaninzeng/tsr-reproduction/work/runs/tsr-llama31-8b-future-tie-all-fast-1112l/scoring/datasets"
              },
              {
                "name": "USER",
                "value": "zaninzeng"
              },
              {
                "name": "LOGNAME",
                "value": "zaninzeng"
              },
              {
                "name": "JUDGE_API_CONCURRENCY",
                "value": "16"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "2",
                "memory": "8Gi"
              },
              "limits": {
                "cpu": "4",
                "memory": "16Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "fsx",
                "mountPath": "/mnt/sn-007"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "fsx",
            "persistentVolumeClaim": {
              "claimName": "youtu-sn2-007"
            }
          }
        ]
      }
    }
  }
}
